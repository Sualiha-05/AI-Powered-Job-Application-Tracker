# Copy to .env and change the secrets
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobtracker

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Backend -> ML service (service name inside Docker network)
ML_SERVICE_URL=http://ml-service:8000

# Frontend (browser) -> backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Production only (see DEPLOY.md). Leave unset for local development. ----
# Shared secret between backend and ML service. Must match on both.
ML_API_KEY=
# Allowed browser origin(s) for CORS, comma separated, e.g. https://your-app.vercel.app
FRONTEND_URL=
# Managed Postgres such as Neon needs SSL
DB_SSL=false
# Create tables automatically (see DEPLOY.md: run this once from your own computer, not on Vercel)
DB_SYNCHRONIZE=false
# Small pool for serverless hosting (default 3)
DB_POOL_MAX=3
# Backend -> ML service request timeout in ms (default 25000; use ~8000 if your function limit is 10 s)
ML_TIMEOUT_MS=25000
# ML service: LLM client limits (use 8 and 0 if your function limit is 10 s)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# LLM extractor (optional: without a key, /extract falls back to method=keyword only).
# Never commit a real key. .env is git-ignored.
# Pick ONE provider. With only one key set, that provider is chosen automatically.
# LLM_PROVIDER: gemini or anthropic (optional)
LLM_PROVIDER=
# Google AI Studio key. Has a free tier; read DEPLOY.md ("Using the free Gemini tier") before letting others use it.
GEMINI_API_KEY=
# Anthropic key (paid). Do not put a Google key here.
ANTHROPIC_API_KEY=
# Leave empty for the provider's default model (gemini-3.5-flash-lite or claude-haiku-5-5).
# If you set it, it must be a model of the provider you chose.
LLM_MODEL=

# AI (LLM) matcher guardrails. Counted over a rolling 24 hours from saved results.
LLM_MATCH_DAILY_LIMIT=10
LLM_MATCH_GLOBAL_DAILY_LIMIT=100

# TF-IDF matcher: share of a requirement's distinctive words a resume line must contain (0.05 to 1, default 0.6).
# Change it only for experiments; record the value with your evaluation results.
TFIDF_THRESHOLD=0.6
